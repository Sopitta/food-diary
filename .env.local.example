NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_...), never exposed to the browser.
# From `npx supabase status` (local) or Project Settings > API Keys (hosted).
# This is the "secret key" that replaces the legacy service_role JWT, which
# Supabase is sunsetting.
SUPABASE_SECRET_KEY=replace-me

OLLAMA_BASE_URL=http://localhost:11434
# Must be a vision-capable model you've pulled locally - check with `ollama list`.
OLLAMA_MODEL=llava

# Which NutritionProvider to use (see lib/nutrition/estimateNutrition.ts):
#   ollama       - local, free, requires Ollama running on this machine (default)
#   huggingface  - hosted via Hugging Face Inference Providers, works when deployed
NUTRITION_PROVIDER=ollama
# Local CPU inference can be slow, especially on the first (cold-start) request.
ESTIMATE_TIMEOUT_MS=60000

# Only needed when NUTRITION_PROVIDER=huggingface. Create a fine-grained token at
# https://huggingface.co/settings/tokens with "Make calls to Inference Providers"
# permission. HUGGINGFACE_MODEL defaults to Qwen/Qwen2.5-VL-72B-Instruct if unset -
# check https://huggingface.co/settings/inference-providers for which VLMs are
# actually routable on your account (smaller checkpoints often aren't).
HUGGINGFACE_API_KEY=replace-me
HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
